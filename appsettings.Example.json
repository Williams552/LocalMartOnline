{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "LocalMartOnline"
  },
  "AIService": {
    "BaseUrl": "http://localhost:5001"
  },
  "Jwt": {
    "Issuer": "LocalMartOnline",
    "Audience": "LocalMartOnlineUsers",
    "Key": "YOUR_SECRET_JWT_KEY_MINIMUM_32_CHARACTERS_LONG",
    "ExpireMinutes": 60
  },
  "Email": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "From": "your-email@gmail.com",
    "Username": "your-email@gmail.com",
    "Password": "YOUR_APP_PASSWORD"
  },
  "App": {
    "BaseUrl": "http://localhost:8080",
    "FrontendUrl": "http://localhost:3000"
  },
  "Firebase": {
    "CredentialPath": "key/serviceAccountKey.json"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Vnpay": {
    "TmnCode": "YOUR_VNPAY_TMNCODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "Command": "pay",
    "CurrCode": "VND",
    "Version": "2.1.0",
    "Locale": "vn"
  },
  "PaymentCallBack": {
    "ReturnUrl": "/api/vnpay/callback"
  },
  "TimeZoneId": "SE Asia Standard Time"
}
